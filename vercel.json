{
  "version": 2,
  "builds": [
    {
      "src": "huddle.js",
      "use": "@vercel/node"
    },
    {
      "src": "setup.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/huddle",
      "dest": "/huddle.js"
    },
    {
      "src": "/api/setup",
      "dest": "/setup.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
